
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  externalId       String   @unique
  attributes       Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  stripeCustomerId String?
  deletionRequestedAt DateTime?

  orders Order[]
}

model Order {
  id     String @id @default(cuid())
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId Int?

  items OrderItem[]

  // Valores financeiros
  subtotal     Float @default(0)
  shippingCost Float @default(5)
  amount       Float
  currency     String
  status       String

  // Dados do comprador
  fullName String?
  cpf      String?
  email    String?
  phone    String?

  // Endereço de entrega
  zipCode      String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?

  // Pagamento e data
  createdDate     DateTime @default(now())
  paymentIntentID String?  @unique

  checkoutKey String? @unique

  trackingTokenHash      String?   @unique
  trackingTokenCreatedAt DateTime?

  statusHistory OrderStatusHistory[]

  emailNotifications EmailNotification[]
}

model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus  String?
  toStatus    String
  source      String
  changedBy   String?
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  stripeProductId String?
  name           String
  description    String?
  quantity       Int
  unitPrice      Int
  image          String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model StripeEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
}
model CheckoutRateLimit {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())

  @@index([windowStartedAt])
}

model EmailNotification {
  id          String   @id @default(cuid())
  orderId     String
  eventType   String
  status      String   @default("pending")
  attempts    Int      @default(0)
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, eventType])
  @@index([status, createdAt])
}
